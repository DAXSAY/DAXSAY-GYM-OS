# =====================================================================
# RADICAL GYM - Configuración (copia este archivo como ".env" y complétalo)
# Nunca subas el .env a GitHub ni lo compartas.
# =====================================================================

# Base de datos MySQL 8 (o MariaDB 10.6+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=radicalgym_app
DB_PASSWORD=cambia-esta-clave
DB_NAME=gestion_radicalgym

# Secreto de las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Servidor
API_PORT=4000
# HOST=0.0.0.0        # solo si el hosting lo pide (por defecto 127.0.0.1 detrás de Nginx)
# TRUST_PROXY=1       # si hay Nginx/Apache/proxy del hosting delante (para la IP real y HTTPS)
# NODE_ENV=production # en el servidor publicado (exige un JWT_SECRET fuerte)
